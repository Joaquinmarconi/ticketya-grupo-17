              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reservas"
              ]
            },
            "description": "Primero ejecuta Login ORGANIZADOR. El rol autenticado no puede usar operaciones de CLIENTE.",
            "auth": {
              "type": "bearer",
