  "item": [
    {
      "name": "Autenticaci?n JWT",
      "description": "Ejecutar el login correspondiente antes de las operaciones protegidas. La colecci?n usa {{jwt}} como bearer token; cada login tambi?n guarda el token por rol.",
      "item": [
        {
          "name": "Login CLIENTE",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"cliente-1\",\"password\":\"cliente123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesi?n como CLIENTE. Guarda el JWT en jwt y jwtCliente. Ejecutar antes de requests que requieren este rol."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login correcto\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"El rol autenticado es CLIENTE\", function () {",
                  "    pm.expect(body.rol).to.eql(\"CLIENTE\");",
                  "});",
                  "pm.collectionVariables.set(\"jwt\", body.token);",
                  "pm.collectionVariables.set(\"jwtCliente\", body.token);"
                ]
              }
            }
          ]
        },
